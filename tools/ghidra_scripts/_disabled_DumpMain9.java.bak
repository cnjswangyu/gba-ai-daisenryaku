// DumpMain9.java —— 修复版: 对 handler 地址先设 TMode=Thumb、清残留、反汇编、建函数, 再反编译
import ghidra.app.script.GhidraScript;
import ghidra.app.decompiler.*;
import ghidra.app.cmd.disassemble.DisassembleCommand;
import ghidra.app.cmd.function.CreateFunctionCmd;
import ghidra.program.model.listing.*;
import ghidra.program.model.address.Address;
import ghidra.program.model.lang.Register;
import ghidra.program.context.ProgramContext;
import java.io.PrintWriter;
import java.math.BigInteger;

public class DumpMain9 extends GhidraScript {
    private DecompInterface dec;
    private PrintWriter out;

    private Register tmodeReg;

    private Function ensureFunction(long from, String tag) throws Exception {
        Function f = getFunctionAt(toAddr(from));
        if (f != null) return f;
        Address a = toAddr(from);
        // 1) 清掉这段可能存在的 ARM 残留指令
        currentProgram.getListing().clearCodeUnits(a, a.add(0x2000), false);
        // 2) 设 TMode=1 (Thumb)
        if (tmodeReg != null) {
            currentProgram.getProgramContext().setValue(tmodeReg, a, a, BigInteger.ONE);
        }
        // 3) 反汇编
        DisassembleCommand dc = new DisassembleCommand(a, null, true);
        boolean ok = dc.applyTo(currentProgram, monitor);
        if (!ok) println(tag + ": 反汇编命令失败");
        // 4) 建函数
        CreateFunctionCmd cc = new CreateFunctionCmd(a);
        cc.applyTo(currentProgram, monitor);
        Function nf = getFunctionAt(a);
        if (nf == null) println(tag + ": 建函数失败");
        return nf;
    }

    private void decompile(long from, String title) throws Exception {
        String hex = "0x" + Long.toHexString(from).toUpperCase();
        out.println("\n/* ===== 反编译 " + title + " @" + hex + " ==== */");
        Function f = ensureFunction(from, hex);
        if (f == null) { out.println("  (建函数失败)"); return; }
        out.println("  函数: " + f.getName() + " @" + f.getEntryPoint() + " size=" + f.getBody().getNumAddresses());
        DecompileResults res = dec.decompileFunction(f, 300, monitor);
        if (res.decompileCompleted()) out.println(res.getDecompiledFunction().getC());
        else out.println("  (反编译失败) " + res.getErrorMessage());
    }

    @Override
    public void run() throws Exception {
        dec = new DecompInterface();
        dec.openProgram(currentProgram);
        out = new PrintWriter("D:/prog/gba-ai/logs/main9.c", "UTF-8");

        // 找 TMode 寄存器
        ProgramContext pctx = currentProgram.getProgramContext();
        for (Register r : pctx.getRegisters()) {
            if (r.getName().equals("TMode")) { tmodeReg = r; break; }
        }
        println("TMode register: " + tmodeReg);

        decompile(0x08004C98, "state0 handler A: 标题 init");
        decompile(0x080143A0, "state0 handler B: 标题帧");
        decompile(0x08004D80, "state1 handler: 主菜单");
        decompile(0x08005180, "state2 handler: 姓名/国家/国歌/确认向导");
        decompile(0x08006ED8, "state3 handler: 剧本选择");
        decompile(0x08007364, "state4 handler: 剧本详情");
        decompile(0x080099B8, "state6 handler: 出击编成表 + 战场");
        decompile(0x08007CE0, "state5 handler");
        decompile(0x0800D5C0, "state7 handler");
        decompile(0x0800EED8, "state8 handler");
        decompile(0x080104C0, "state9 handler");
        decompile(0x080105D8, "state10 handler");
        decompile(0x0800F7D8, "state11 handler");
        decompile(0x08007084, "state12 handler");
        decompile(0x08010A90, "state13 handler");
        decompile(0x0802EEE0, "state14 handler");
        out.close();
        println("完成 main9.c");
    }
}
